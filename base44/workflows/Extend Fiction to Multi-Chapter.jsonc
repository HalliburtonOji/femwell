{
  "name": "Extend Fiction to Multi-Chapter",
  "description": "Daily job that picks up to 3 published fiction items with fewer than 5 chapters and extends them via extendFiction (gpt-4o-mini). Self-clearing as records reach the target.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 2 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "extend_fiction_to_multi_chapter",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pipelineOrchestrator",
            "args": {
              "run_phase": "extendFictionDaily"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "pipelineOrchestrator"
  }
}