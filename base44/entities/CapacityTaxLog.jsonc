{
  "name": "CapacityTaxLog",
  "type": "object",
  "description": "Per-user week-grain rolling log of Planner Capacity Tax computations. One row per (user_id, week_start). Written by computeCapacityTax (C3) and read by the Cycle tab Capacity Tax bar + Cycle Mirror retrospective. Default retention 12 months rolling per spec §C1 open question 5; older rows can be summarised onto UserProfile.cycle_history.",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "week_start": {
      "type": "string",
      "format": "date",
      "description": "ISO date (YYYY-MM-DD) of the Monday that starts this rolling week."
    },
    "predicted_load": {
      "type": "number",
      "default": 0,
      "description": "Sum of (PersonalTask.estimated_effort * phase_modifier) + (active habits * 1) + (active programmes * 1.5). Higher = more on the plate."
    },
    "phase_capacity": {
      "type": "number",
      "default": 0,
      "description": "Baseline (default 10) * phase multiplier (menstrual 0.55, follicular 1.1, ovulatory 1.2, luteal 0.85). Available capacity for this cycle phase."
    },
    "pct_of_capacity": {
      "type": "number",
      "default": 0,
      "description": "predicted_load / phase_capacity * 100. 100 = at capacity; >120 = Capacity Tax bar shows the over-capacity state."
    },
    "deferred_count": {
      "type": "integer",
      "default": 0,
      "description": "Cumulative count of tasks the user has deferred via the Defer pill this week. Used for Cycle Mirror's 'how often you reach for a steadier window' line."
    },
    "computed_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "week_start"
  ]
}
