{
  "name": "LifestyleSources",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "RSS",
        "BLOG",
        "NEWS",
        "YOUTUBE_CHANNEL",
        "TIKTOK",
        "INSTAGRAM"
      ],
      "default": "RSS"
    },
    "url": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Women's Health",
        "Relationships",
        "Career & Money",
        "Beauty",
        "Lifestyle",
        "Mental Wellness",
        "Food",
        "Fitness",
        "Culture",
        "Parenting",
        "Sex Education",
        "Menopause",
        "PCOS",
        "PMS",
        "Fashion"
      ],
      "default": "Lifestyle"
    },
    "language": {
      "type": "string",
      "default": "en"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "trust_score": {
      "type": "number",
      "default": 5
    },
    "logo_url": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "RSS",
        "BLOG",
        "NEWS",
        "YOUTUBE_CHANNEL",
        "TIKTOK",
        "INSTAGRAM",
        "MANUAL"
      ],
      "default": "RSS"
    },
    "feed_url": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "priority": {
      "type": "number",
      "default": 5
    },
    "daily_item_cap": {
      "type": "number",
      "default": 5,
      "description": "Max LifestyleItems this source can produce per 24h ingest cycle. Null/undefined treated as 5 (RSS) or 3 (YouTube hardcoded constant) by ingest logic."
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}