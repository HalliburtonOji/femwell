{
  "name": "PanicSessions",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "day_key": {
      "type": "string"
    },
    "logged_at": {
      "type": "string"
    },
    "intensity": {
      "type": "number",
      "default": 3
    },
    "feeling_type": {
      "type": "string",
      "enum": [
        "panic",
        "anxiety",
        "overwhelm",
        "anger",
        "sadness"
      ],
      "default": "anxiety"
    },
    "notes": {
      "type": "string"
    },
    "cards_completed": {
      "type": "number",
      "default": 0
    },
    "deck_type": {
      "type": "string",
      "default": "GUIDED"
    },
    "resolved_rating": {
      "type": "number"
    },
    "duration_seconds": {
      "type": "number"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "day_key"
  ]
}