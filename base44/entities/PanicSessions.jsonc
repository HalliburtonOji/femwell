{
  "name": "PanicSessions",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "day_key": {
      "type": "string"
    },
    "logged_at": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "ended_at": {
      "type": "string"
    },
    "intensity": {
      "type": "number",
      "default": 3
    },
    "feeling_type": {
      "type": "string",
      "enum": [
        "panic",
        "anxiety",
        "overwhelm",
        "anger",
        "sadness"
      ],
      "default": "anxiety"
    },
    "trigger_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "techniques_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "cards_completed": {
      "type": "number",
      "default": 0
    },
    "deck_type": {
      "type": "string",
      "default": "GUIDED"
    },
    "resolved_rating": {
      "type": "number"
    },
    "post_session_rating": {
      "type": "number",
      "description": "1-5 rating after session"
    },
    "duration_seconds": {
      "type": "number"
    },
    "cycle_phase_at_session": {
      "type": "string",
      "description": "Phase at session start. Null when unknown \u2014 never fabricated."
    },
    "migrated_from": {
      "type": "string",
      "description": "Set to 'PanicLog' for rows imported during consolidation."
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "day_key"
  ]
}