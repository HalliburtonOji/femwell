{
  "name": "LifestyleItems",
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "source_logo_url": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "content_url": {
      "type": "string"
    },
    "embed_url": {
      "type": "string",
      "description": "Canonical embed URL when is_embeddable=true. For YouTube: https://www.youtube.com/embed/<video_id>"
    },
    "content_url_hash": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Women's Health",
        "Relationships",
        "Career & Money",
        "Beauty",
        "Lifestyle",
        "Mental Wellness",
        "Food",
        "Fitness",
        "Culture",
        "Parenting",
        "Sex Education",
        "Menopause",
        "PCOS",
        "PMS",
        "Mental Health",
        "Nutrition",
        "Mindfulness",
        "Sleep",
        "Hormones & Cycle",
        "Skin & Hair",
        "Gut Health",
        "Fertility",
        "Body Image",
        "Supplements",
        "Stress",
        "Self Care",
        "Fashion"
      ],
      "default": "Lifestyle"
    },
    "summary": {
      "type": "string"
    },
    "takeaways": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "why_it_matters": {
      "type": "string"
    },
    "try_this_content_key": {
      "type": "string"
    },
    "try_this_label": {
      "type": "string"
    },
    "published_at": {
      "type": "string"
    },
    "ingested_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "NEEDS_REVIEW",
        "SUMMARIZED",
        "PUBLISHED",
        "HIDDEN",
        "REJECTED_EMBED",
        "DEAD_LINK",
        "FAILED"
      ],
      "default": "NEEDS_REVIEW"
    },
    "revalidated_at": {
      "type": "string",
      "description": "ISO timestamp of the most recent successful HEAD check on content_url. Null until first revalidateUrls run."
    },
    "is_editor_pick": {
      "type": "boolean",
      "default": false
    },
    "is_trending": {
      "type": "boolean",
      "default": false
    },
    "media_type": {
      "type": "string",
      "enum": [
        "ARTICLE",
        "VIDEO",
        "TIKTOK",
        "INSTAGRAM",
        "CLIP",
        "PODCAST"
      ],
      "default": "ARTICLE"
    },
    "provider": {
      "type": "string",
      "enum": [
        "RSS",
        "BLOG",
        "NEWS",
        "YOUTUBE",
        "TIKTOK",
        "INSTAGRAM",
        "FEMWELL_AI",
        "FEMWELL_AI_USER_REQUEST",
        "FEMWELL_FICTION_WEEKLY",
        "FEMWELL_FICTION_PERSONAL"
      ],
      "default": "RSS"
    },
    "engagement_score": {
      "type": "number",
      "default": 0
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "author_name": {
      "type": "string"
    },
    "lede": {
      "type": "string"
    },
    "channel_name": {
      "type": "string"
    },
    "channel_id": {
      "type": "string"
    },
    "video_id": {
      "type": "string"
    },
    "duration_label": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number",
      "description": "Video duration in seconds; populated for VIDEO"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Set when item is auto-HIDDEN or REJECTED_EMBED"
    },
    "is_embeddable": {
      "type": "boolean",
      "description": "Verified at ingest. True only if the video can play directly in the app."
    },
    "embed_check_reason": {
      "type": "string",
      "description": "When is_embeddable=false, why"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "ARTICLE",
        "VIDEO",
        "STORY",
        "GUIDE",
        "FICTION"
      ],
      "default": "ARTICLE"
    },
    "emotional_tag": {
      "type": "string",
      "enum": [
        "Relationships",
        "Body",
        "Identity",
        "Grief",
        "Motherhood",
        "Career",
        "Mental Health",
        "Self-Discovery",
        ""
      ]
    },
    "phase_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "content_url"
  ]
}