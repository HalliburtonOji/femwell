      "type": "string"
    },
    "day_key": {
      "type": "string"
    },
    "logged_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "mild",
        "moderate",
        "severe"
      ],
      "type": "string"
    },
    "trigger": {
      "enum": [
        "stress",
        "caffeine",
        "hot_room",
        "spicy_food",
        "alcohol",
        "exercise",
        "clothing",
        "other",
        "unknown"
      ],
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "day_key",
    "logged_at"
  ],
  "type": "object"
}