{
  "name": "UserPreferences",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lifestyle_interests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coach_tone": {
      "type": "string",
      "enum": [
        "gentle",
        "straight",
        "minimal"
      ],
      "default": "gentle"
    },
    "notification_time": {
      "type": "string",
      "enum": [
        "morning",
        "evening"
      ],
      "default": "morning"
    },
    "hydration_target_ml": {
      "type": "number",
      "default": 2000
    },
    "body_goal": {
      "type": "string",
      "enum": [
        "fat_loss",
        "tone",
        "energy",
        "hormone_support",
        "postpartum",
        "menopause"
      ]
    },
    "cycle_tracking_enabled": {
      "type": "boolean",
      "default": true
    },
    "horoscope_quiet_mode": {
      "type": "boolean",
      "default": false,
      "description": "When true, the horoscope LLMs avoid shadow-language (war/wound/trauma/crisis/doom/endings) and frame challenges as something-to-notice instead of something-to-fear."
    },
    "horoscope_soft_sky": {
      "type": "boolean",
      "default": false,
      "description": "A3 Soft Sky sub-tier. When true (only meaningful when horoscope_quiet_mode is also true), the daily reading omits planetary retrogrades and 'storm windows'."
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id"
  ]
}