{
  "name": "JournalEntries",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "content_id": {
      "type": "string"
    },
    "content_key": {
      "type": "string"
    },
    "session_date": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "mood_rating": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "program_key": {
      "type": "string"
    },
    "day_number": {
      "type": "number"
    },
    "prompt": {
      "type": "string"
    },
    "card_color": {
      "type": "string",
      "enum": [
        "rose",
        "peach",
        "yellow",
        "mint",
        "sky",
        "lavender",
        "lilac",
        "sage"
      ],
      "default": "lavender"
    },
    "card_type": {
      "type": "string",
      "enum": [
        "free",
        "gratitude",
        "mood",
        "todo",
        "reflection",
        "affirmation",
        "dream"
      ],
      "default": "free"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    },
    "todo_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "done": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id"
  ],
  "indexes": [ { "fields": ["created_date"] }, { "fields": ["session_date"] } ]
}
