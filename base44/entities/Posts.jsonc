{
  "name": "Posts",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "anonymous": {
      "type": "boolean",
      "default": false
    },
    "phase_tag": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "general",
        "gratitude",
        "real_talk",
        "question",
        "milestone"
      ],
      "default": "general"
    },
    "content": {
      "type": "string"
    },
    "moderation_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "reactions": {
      "type": "object",
      "properties": {
        "feel_this": {
          "type": "number",
          "default": 0
        },
        "same": {
          "type": "number",
          "default": 0
        },
        "sending_love": {
          "type": "number",
          "default": 0
        }
      }
    },
    "reply_count": {
      "type": "number",
      "default": 0
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "content"
  ]
}