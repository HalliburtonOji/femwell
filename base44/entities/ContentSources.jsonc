{
  "name": "ContentSources",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "rss_url": {
      "type": "string"
    },
    "site_url": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "priority": {
      "type": "number"
    },
    "language": {
      "type": "string",
      "default": "en"
    },
    "added_date": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "rss_url",
    "site_url",
    "category"
  ]
}