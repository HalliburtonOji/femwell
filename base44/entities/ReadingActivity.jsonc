{
  // Books & Book Clubs (Phase 1) — one anonymous reading act, used for community aggregates
  // ONLY: "guess the next chapter" projective predictions and shared-read cohort milestones
  // ("N of you have reached chapter 5"). Only a device-derived author_hash is stored — NEVER a
  // user_id or email, by design (anonymity-first, like Echo). Free-text `body` is crisis-checked
  // + scrubbed client-side before write; `progress` rows carry an empty body.
  //
  // Private SOLO reflections do NOT come here — they stay device-local. Only predictions /
  // progress / club-shared (anonymous) rows are written, OPTIMISTIC + FIRE-AND-FORGET, never
  // awaited on an interaction path; reads fail open.
  //
  // RLS (Phase-2 HARDENED): read + create + update + delete are ALL locked to role:admin. A
  // normal client can NO LONGER read or write rows directly — all writes go through the
  // asServiceRole `postReadingActivity` function and all reads through the asServiceRole
  // `readingAggregate` function (which returns only the warm, k-floored aggregate — never raw
  // rows). asServiceRole acts as role:admin [[base44-service-role-rls-admin]], so the functions
  // pass while clients are denied. This hardens anonymity: rows are written under the SERVICE
  // identity (the platform created_by is the service, never the user's email), and no client can
  // ever pull raw rows to de-anonymise an author_hash.
  "name": "ReadingActivity",
  "type": "object",
  "properties": {
    "author_hash": { "type": "string", "description": "Device-derived anonymous author token — never a raw user id or email." },
    "book_id": { "type": "string", "description": "Per-book key (the Gutenberg id as a string for Library / Book Club reads)." },
    "chapter_index": { "type": "number", "description": "0-based chapter index this act refers to (chapter 1 in the UI = 0)." },
    "kind": {
      "type": "string",
      "enum": [
        "prediction",
        "progress",
        "club_reflection"
      ],
      "default": "progress",
      "description": "prediction = guess-the-next-chapter; progress = reached-this-chapter (empty body); club_reflection = a reflection shared to the room."
    },
    "body": { "type": "string", "description": "Free text (crisis-checked + scrubbed); empty for progress rows." },
    "hidden": { "type": "boolean", "default": false, "description": "When true, suppressed from aggregates (moderation)." }
  },
  "required": [
    "author_hash",
    "book_id",
    "chapter_index",
    "kind"
  ],
  "indexes": [ { "fields": ["created_date"] },
    { "fields": ["book_id"] },
    { "fields": ["author_hash"] }
  ],
  "rls": {
    "read":   { "user_condition": { "role": "admin" } },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
