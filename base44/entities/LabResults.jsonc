      "type": "string"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "type": "string"
    },
    "test_date": {
      "type": "string"
    },
    "lab_name": {
      "type": "string"
    },
    "normal_range_min": {
      "type": "number"
    },
    "normal_range_max": {
      "type": "number"
    },
