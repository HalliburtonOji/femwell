{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "coach_name": {
      "type": "string",
      "description": "Custom name the user gives their AI coach"
    },
    "coach_archetype": {
      "type": "string",
      "enum": [
        "empathetic",
        "motivator",
        "analyst",
        "nurturing"
      ],
      "default": "empathetic",
      "description": "Coaching personality style"
    },
    "coach_tone": {
      "type": "string",
      "description": "Preferred coach tone",
      "default": "Warm"
    }
  },
  "required": [
    "role"
  ]
}