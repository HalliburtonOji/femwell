{
  "name": "MenopauseProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "perimenopause",
        "menopause",
        "postmenopause"
      ],
      "default": "perimenopause"
    },
    "care_focus": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cycle_changes": {
      "type": "string"
    },
    "current_supports": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id"
  ]
}