{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "onboarding_step": {
      "type": "number",
      "default": 0
    },
    "onboarding_steps_completed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modules_enabled": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cycle_avg_length": {
      "type": "number"
    },
    "period_length": {
      "type": "number"
    },
    "last_period_start_date": {
      "type": "string"
    },
    "reminder_checkin_time": {
      "type": "string"
    },
    "reminder_meditation_time": {
      "type": "string"
    },
    "reminder_workout_days": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "units": {
      "type": "string",
      "enum": [
        "metric",
        "imperial"
      ],
      "default": "metric"
    },
    "tone_preference": {
      "type": "string",
      "enum": [
        "warm",
        "clinical",
        "motivational",
        "gentle",
        "straight",
        "minimal"
      ],
      "default": "warm"
    },
    "condition_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skin_type": {
      "type": "string"
    },
    "followed_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "liked_item_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "saved_item_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "saved_item_phases": {
      "type": "object",
      "description": "Map of lifestyle item id -> cycle phase tag chosen at save time",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "menstrual",
          "follicular",
          "ovulatory",
          "luteal"
        ]
      },
      "default": {}
    },
    "blocked_source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_used_category": {
      "type": "string"
    },
    "birthday": {
      "type": "string"
    },
    "location_city": {
      "type": "string"
    },
    "ai_assistant_name": {
      "type": "string",
      "default": "Guide"
    },
    "hairstyle_tries_this_month": {
      "type": "number",
      "default": 0
    },
    "for_you_item_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allow_mature_content": {
      "type": "boolean",
      "default": false
    },
    "mature_confirmed_at": {
      "type": "string"
    },
    "life_stage": {
      "type": "string",
      "enum": [
        "none",
        "pregnancy",
        "menopause",
        "ttc"
      ],
      "default": "none"
    },
    "life_stage_focus": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hydration_target_ml": {
      "type": "number",
      "default": 2000
    },
    "pregnancy_start_date": {
      "type": "string"
    },
    "pregnancy_due_date": {
      "type": "string"
    },
    "anonymous_mode": {
      "type": "boolean",
      "default": false
    },
    "meal_score_migrated_v1": {
      "type": "boolean",
      "default": false,
      "description": "Guard flag: has 1-10 scale migration run for this user's last 20 meal logs"
    },
    "ai_analysis_migrated_v1": {
      "type": "boolean",
      "default": false,
      "description": "Guard flag: has ai_analysis string->object migration run for this user"
    },
    "last_disclaimer_shown_at": {
      "type": "string",
      "description": "ISO timestamp of when the nutrition safety disclaimer was last shown"
    },
    "completed_sessions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of WellnessSessions the user has marked complete"
    },
    "favorite_sessions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of WellnessSessions the user has favorited"
    },
    "completed_sessions_count": {
      "type": "number",
      "default": 0
    },
    "bio": {
      "type": "string",
      "description": "Short bio, max 200 chars (client-enforced)"
    },
    "notification_preferences": {
      "type": "object",
      "description": "MP#9 notification toggles",
      "properties": {
        "daily_checkin_reminder": {
          "type": "boolean",
          "default": true
        },
        "cycle_prediction_alerts": {
          "type": "boolean",
          "default": true
        },
        "educational_content_weekly": {
          "type": "boolean",
          "default": true
        },
        "community_replies": {
          "type": "boolean",
          "default": true
        },
        "marketing_emails": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": true
    },
    "profile_is_public": {
      "type": "boolean",
      "default": false
    },
    "allow_anonymous_community_posts": {
      "type": "boolean",
      "default": true
    },
    "show_in_circle_finder": {
      "type": "boolean",
      "default": false
    },
    "hrt_regimen": {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean",
          "default": false
        },
        "method": {
          "type": "string",
          "enum": [
            "patch",
            "gel",
            "tablet",
            "implant",
            "none"
          ]
        },
        "evening_dose": {
          "type": "string"
        },
        "reminder_time": {
          "type": "string",
          "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$"
        }
      }
    },
    "cycle_prediction_meta": {
      "type": "object",
      "properties": {
        "confidence_pct": {
          "type": "number"
        },
        "cycles_observed": {
          "type": "integer",
          "default": 0
        },
        "next_period_eta": {
          "type": "string",
          "format": "date"
        },
        "eta_window_days": {
          "type": "integer",
          "default": 3
        }
      }
    },
    "pacing_bank_opt_in": {
      "type": "boolean",
      "default": false
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "partner_share_code": {
      "type": "string",
      "description": "6-char share code for /partner?code= view"
    },
    "partner_sharing_settings": {
      "type": "object",
      "description": "Partner-view toggle flags",
      "properties": {
        "show_mood_energy": {
          "type": "boolean"
        },
        "show_phase": {
          "type": "boolean"
        },
        "show_tips": {
          "type": "boolean"
        }
      }
    },
    "analytics_consent": {
      "type": "boolean",
      "description": "Sprint 12 \u2014 opt-in to anonymous analytics",
      "default": true
    },
    "consent_flags": {
      "type": "object",
      "description": "Sprint 12 batch 2 \u2014 explicit GDPR consent flags",
      "properties": {
        "health_data": {
          "type": "boolean"
        },
        "ai_companion": {
          "type": "boolean"
        },
        "age_confirmed": {
          "type": "boolean"
        },
        "consented_at": {
          "type": "string"
        }
      }
    },
    "is_minor": {
      "type": "boolean",
      "description": "Sprint 12 batch 3 \u2014 true when age_band is 13-17"
    },
    "age_band": {
      "type": "string",
      "description": "Sprint 12 batch 3 \u2014 under_13 | 13-17 | 18plus"
    }
  },
  "required": [
    "user_id"
  ]
}