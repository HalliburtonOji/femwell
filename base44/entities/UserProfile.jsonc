{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "onboarding_step": {
      "type": "number",
      "default": 0
    },
    "onboarding_steps_completed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modules_enabled": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cycle_avg_length": {
      "type": "number"
    },
    "period_length": {
      "type": "number"
    },
    "last_period_start_date": {
      "type": "string"
    },
    "reminder_checkin_time": {
      "type": "string"
    },
    "reminder_meditation_time": {
      "type": "string"
    },
    "reminder_workout_days": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "units": {
      "type": "string",
      "enum": [
        "metric",
        "imperial"
      ],
      "default": "metric"
    },
    "tone_preference": {
      "type": "string",
      "enum": [
        "warm",
        "clinical",
        "motivational",
        "gentle",
        "straight",
        "minimal"
      ],
      "default": "warm"
    },
    "condition_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skin_type": {
      "type": "string"
    },
    "followed_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "liked_item_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "saved_item_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_used_category": {
      "type": "string"
    },
    "birthday": {
      "type": "string"
    },
    "location_city": {
      "type": "string"
    },
    "ai_assistant_name": {
      "type": "string",
      "default": "Guide"
    },
    "hairstyle_tries_this_month": {
      "type": "number",
      "default": 0
    },
    "for_you_item_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allow_mature_content": {
      "type": "boolean",
      "default": false
    },
    "mature_confirmed_at": {
      "type": "string"
    },
    "life_stage": {
      "type": "string",
      "enum": [
        "none",
        "pregnancy",
        "menopause",
        "ttc"
      ],
      "default": "none"
    },
    "life_stage_focus": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hydration_target_ml": {
      "type": "number",
      "default": 2000
    },
    "pregnancy_start_date": {
      "type": "string"
    },
    "pregnancy_due_date": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id"
  ]
}