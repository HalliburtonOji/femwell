{
  "name": "Deals",
  "type": "object",
  "required": [
    "title",
    "brand",
    "category"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Supplements",
        "Period care",
        "Skincare",
        "Fitness",
        "Books",
        "Other"
      ]
    },
    "discount_text": {
      "type": "string"
    },
    "external_url": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "indexes": [ { "fields": ["created_date"] } ]
}
