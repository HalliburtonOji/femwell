// HrtLog — STEP 6 of the Life Stage build.
//
// User-recorded HRT regimens. One row per started course of HRT.
// Updated in place (not append-only) when the user changes type / dose /
// route within the same course. A new course (e.g. switching from
// utrogestan to mirena) creates a new row.
//
// Read by:
//   src/components/planner/cycle/HrtLogCard.jsx (Cycle tab, peri / meno modes)
//   src/components/planner/today/PillarsDeck.jsx (HRT log pillar tile)
//
// Schema migration via base44 AI builder — see
// claude-handoff/from-cowork-to-halli-2026-05-16-step6-hrtlog-entity-prompt.md
{
  "name": "HrtLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "description": "HRT type — e.g. oestradiol patch, oestradiol gel, utrogestan, mirena, testosterone gel, vaginal oestrogen (Gina / Vagifem).",
      "enum": [
        "oestradiol-patch",
        "oestradiol-gel",
        "oestradiol-tablet",
        "utrogestan",
        "mirena-ius",
        "combined-pill",
        "testosterone-gel",
        "vaginal-oestrogen",
        "other"
      ]
    },
    "dose": {
      "type": "string",
      "description": "Free-text dose — e.g. \"75 mcg / 24h\", \"100 mg\", \"2 pumps\"."
    },
    "route": {
      "type": "string",
      "description": "Delivery route — patch | gel | tablet | iud | pessary | other.",
      "enum": [
        "patch",
        "gel",
        "tablet",
        "iud",
        "pessary",
        "injection",
        "other"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Set when the user stops or switches. Null while the regimen is active."
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "type",
    "start_date"
  ]
}
