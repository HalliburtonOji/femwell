{
  "name": "EventsItems",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "price": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "women networking",
        "fitness/wellness",
        "talks & workshops",
        "relationship / therapy events",
        "general"
      ],
      "default": "general"
    },
    "is_free": {
      "type": "boolean",
      "default": false
    },
    "city": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "verified": {
      "type": "boolean"
    },
    "verified_at": {
      "type": "string"
    },
    "ticket_platform": {
      "type": "string"
    },
    "is_online": {
      "type": "boolean",
      "default": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date",
    "link"
  ],
  "indexes": [ { "fields": ["date"] }, { "fields": ["created_date"] } ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
