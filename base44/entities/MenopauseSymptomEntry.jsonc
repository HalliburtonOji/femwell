{
  "name": "MenopauseSymptomEntry",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "day_key": {
      "type": "string"
    },
    "symptom_type": {
      "type": "string",
      "enum": [
        "Hot flush",
        "Night sweats",
        "Sleep issues",
        "Mood changes",
        "Anxiety",
        "Brain fog",
        "Joint pain",
        "Low libido",
        "Vaginal dryness",
        "Bleeding changes"
      ]
    },
    "severity_1_5": {
      "type": "number",
      "default": 3
    },
    "trigger_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "day_key",
    "symptom_type"
  ]
}