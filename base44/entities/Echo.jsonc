{
  "name": "Echo",
  "type": "object",
  "properties": {
    "body": {
      "type": "string",
      "description": "The anonymous echo text content"
    },
    "author_hash": {
      "type": "string",
      "description": "Hashed author identifier \u2014 never raw user ID"
    },
    "phase": {
      "type": "string",
      "enum": [
        "menstrual",
        "follicular",
        "ovulatory",
        "luteal",
        "unknown"
      ],
      "default": "unknown",
      "description": "Cycle phase of the author at time of posting"
    },
    "life_stage": {
      "type": "string",
      "description": "Life stage of the author (e.g. ttc, pregnant, menopause)"
    },
    "cycle_day": {
      "type": "number",
      "description": "Cycle day of the author at time of posting"
    },
    "source_entry_hash": {
      "type": "string",
      "description": "Hash of the originating journal entry, if shared from one"
    },
    "live_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when the echo becomes visible on the wall"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when the echo is removed from the wall"
    },
    "held_count": {
      "type": "number",
      "default": 0,
      "description": "Number of users who tapped 'I hold this'"
    },
    "metoo_count": {
      "type": "number",
      "default": 0,
      "description": "Number of users who tapped 'Same' (formerly 'Me too')"
    },
    "hearyou_count": {
      "type": "number",
      "default": 0,
      "description": "Number of users who tapped 'Hear you'"
    },
    "saved_count": {
      "type": "number",
      "default": 0,
      "description": "Number of users who tapped 'Saved'"
    },
    "report_count": {
      "type": "number",
      "default": 0,
      "description": "Number of reports flagging this echo for review"
    },
    "hidden": {
      "type": "boolean",
      "default": false,
      "description": "When true, echo is suppressed from the wall (moderation)"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "same_phase",
        "circles",
        "all"
      ],
      "default": "all",
      "description": "Audience scope for this echo"
    }
  },
  "required": [
    "body",
    "author_hash",
    "live_at",
    "expires_at"
  ],
  "indexes": [
    {
      "fields": [
        "phase"
      ]
    },
    {
      "fields": [
        "expires_at"
      ]
    },
    {
      "fields": [
        "hidden"
      ]
    }
  ],
  // Echo-write lock (final audit residual): the WALL MUST STAY PUBLICLY READABLE, so
  // `read` is intentionally OMITTED here (it keeps the entity's public-read default —
  // do NOT add a read rule). Only WRITES are locked to the service role: all of
  // create / update / delete now go through asServiceRole functions (postEcho /
  // reactEcho / reportEcho / retractEcho), so a plain client can no longer set
  // arbitrary fields, fake counts, hide, or delete others' echoes directly.
  // VERIFY ON DEPLOY: Echo.filter (read) still 200; a direct client Echo.create /
  // .update / .delete now 403 (owner token still bypasses — same caveat as B3).
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}