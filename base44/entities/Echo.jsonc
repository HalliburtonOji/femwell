{
  "name": "Echo",
  "type": "object",
  "description": "Echo Wall (Phase 3, first social tier). An anonymous one-line entry shared from the Journal to women in the same phase. No replies, no DMs. Reactions are a small fixed lexicon (held / me too). Echoes fade 48h after they go live. Anonymity: rows carry ONLY a salted, device-derived author_hash (no user_id / email / name is written by the app). The author can retract their own echo by recomputing the hash on the same device. Safety rails (scrub, cooling pause, late-night/late-luteal throttle, crisis intercept, auto-unpost, report+auto-hide) are enforced in the client before/around create. NOTE: base44's platform-level built-in created_by still records the creator; the app never surfaces it and never queries by it. Full server-side anonymity (write under a service identity) is the Q3 hardening, flagged in STATUS.",
  "properties": {
    "body": {
      "type": "string",
      "description": "The scrubbed single line (<= 180 chars, no newlines). Already passed the on-device Jess scrub + crisis intercept before create. Plain text (the wall is meant to be read by all sisters, so this is NOT encrypted)."
    },
    "author_hash": {
      "type": "string",
      "description": "Salted SHA-256 of the author's user id + a per-device secret (localStorage fw_echo_anon_v1), computed on-device. The row carries NO user_id / email / display name. Only the author's own device can recompute this hash, which is how retract works without de-anonymising."
    },
    "phase": {
      "type": "string",
      "enum": ["menstrual", "follicular", "ovulatory", "luteal", "unknown"],
      "default": "unknown",
      "description": "The author's cycle phase at post time. Drives phase-sister feed weighting (a soft boost, never a hard filter)."
    },
    "life_stage": {
      "type": "string",
      "description": "Optional life-stage cohort (teen, reproductive, perimenopause, menopause, post-menopause, etc.) for finer weighting. Never identifying on its own."
    },
    "cycle_day": {
      "type": "number",
      "description": "Optional cycle day at post (e.g. for 'luteal d18-20' cohort copy). Coarse, non-identifying."
    },
    "source_entry_hash": {
      "type": "string",
      "description": "Optional one-way hash of the source journal entry id (salted with the device secret). Lets the author's own device recognise which echo came from which entry; never joined server-side to the entry."
    },
    "live_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the cooling pause ends and the echo becomes visible on the wall. Until then it is 'still cooling' and only the author sees it (and can pull it back). Late-night + late-luteal posts get a longer pause."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the echo fades. Set to live_at + 48h. The wall never renders an echo past this; the author's device hard-deletes its own expired echoes when it next loads (auto-unpost)."
    },
    "held_count": {
      "type": "number",
      "default": 0,
      "description": "'held' reactions. Emotional, not transactional; never used to rank the feed."
    },
    "metoo_count": {
      "type": "number",
      "default": 0,
      "description": "'me too' reactions. Never used to rank the feed."
    },
    "report_count": {
      "type": "number",
      "default": 0,
      "description": "Flags from readers. When it reaches the auto-hide threshold the client sets hidden = true."
    },
    "hidden": {
      "type": "boolean",
      "default": false,
      "description": "True once auto-hidden by reports crossing the threshold, OR retracted by the author. A hidden echo is never shown on the wall."
    },
    "visibility": {
      "type": "string",
      "enum": ["same_phase", "circles", "all"],
      "default": "all",
      "description": "Reserved for forward-compat. v1 is always 'all' (everyone can see; phase sisters are weighted up in ranking, not filtered)."
    }
  },
  "required": ["body", "author_hash", "live_at", "expires_at"],
  "indexes": [
    { "fields": ["phase"] },
    { "fields": ["expires_at"] },
    { "fields": ["hidden"] }
  ]
}
