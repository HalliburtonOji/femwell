// JessMemory — Feature 2 of the Jess major build sprint.
//
// Persistent things Jess has learned about a user across conversations.
// Written by jessMemoryService.extractMemoriesFromConversation() after
// a thread closes (user taps "✦ New" or leaves the panel). Read on
// every fresh conversation start so Jess can reference them naturally.
//
// Read + written by:
//   src/components/assistant/JessDemoPanel.jsx
//   src/components/assistant/JessSettingsSheet.jsx
//   src/services/jessMemoryService.js
//
// Schema mirrored from the React code:
//   - user_id              : string, required. Owning user.
//   - memory_type          : enum string.
//                             "preference"          — e.g. "User prefers morning workouts"
//                             "health_pattern"      — e.g. "Sleep dips before period"
//                             "emotional_context"   — e.g. "Anxious before ovulation"
//                             "explicit_statement"  — e.g. "User said she's TTC"
//                             "goal"                — e.g. "Wants to walk 10k steps/day"
//                             "follow_up"           — e.g. "Asked about iron supplements"
//   - content              : string, required. Concise 1-sentence memory.
//   - source_conv_id       : string. JessConversation.id this came from.
//   - importance_score     : number, default 5. 1–10 scale. Only ≥5 get
//                             persisted by the extractor; UI sorts by this
//                             desc.
//   - is_active            : boolean, default true. Soft-delete flag; the
//                             settings sheet's ✕ button flips this to false.
//   - date_last_referenced : string (ISO). Updated when Jess actually
//                             surfaces this memory in a reply (future use).
//   - tags                 : string. Comma-separated keywords for search.
{
  "name": "JessMemory",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "memory_type": {
      "type": "string",
      "enum": [
        "preference",
        "health_pattern",
        "emotional_context",
        "explicit_statement",
        "goal",
        "follow_up"
      ]
    },
    "content": {
      "type": "string"
    },
    "source_conv_id": {
      "type": "string"
    },
    "importance_score": {
      "type": "number",
      "default": 5
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "date_last_referenced": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "content"
  ]
}
