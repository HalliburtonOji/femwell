// JessConversation — Feature 1 of the Jess major build sprint.
//
// One row per Jess chat thread. Eagerly created when the user taps the
// "✦ New" button or sends their first message in a fresh thread. Read by
// the Jess history drawer (Today / This week / Earlier sections), and
// updated by sendUserText (message_count + preview_text + updated_date)
// and by autoNameConversation (name + name_status after the user's 2nd
// message).
//
// Read + written by:
//   src/components/assistant/JessDemoPanel.jsx
//
// Schema mirrored from the React code:
//   - user_id        : string, required. Owning user (auth.me().id).
//   - agent_conv_id  : string. base44.agents conversation id the thread
//                       is attached to. Used by loadConversation to
//                       re-subscribe to existing thread transcripts.
//   - name           : string. 2–4 word title from autoNameConversation.
//                       Null while name_status is "pending".
//   - name_status    : enum "pending" | "named" | "failed". Drives the
//                       drawer's italic "New conversation" placeholder
//                       while pending; flips to "named" when the namer
//                       writes a title; "failed" when the namer stalls
//                       and the 7s fallback timer writes "DD Mon Chat".
//   - preview_text   : string. First user message snippet, clipped to
//                       80 chars. Set once on the first send.
//   - message_count  : number, default 0. Incremented on each user send.
//   - is_deleted     : boolean, default false. Soft-delete flag flipped
//                       by softDeleteConvo from the drawer's swipe-to-
//                       delete row action.
{
  "name": "JessConversation",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "agent_conv_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "name_status": {
      "type": "string",
      "enum": [
        "pending",
        "named",
        "failed"
      ],
      "default": "pending"
    },
    "preview_text": {
      "type": "string"
    },
    "message_count": {
      "type": "number",
      "default": 0
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id"
  ]
}
