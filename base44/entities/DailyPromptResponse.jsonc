    },
    "day_key": {
      "type": "string"
    },
    "main_focus": {
      "type": "string"
    },
    "mood": {
      "type": "number",
      "default": 3
    },
    "energy": {
      "type": "number",
      "default": 3
    },
    "created_at": {
      "type": "string"
    },
