{
  "name": "PartnerAccess",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string"
    },
    "partner_email": {
      "type": "string"
    },
    "access_token": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "expires_at": {
      "type": "string"
    },
    "last_accessed_at": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "owner_user_id",
    "partner_email"
  ]
}