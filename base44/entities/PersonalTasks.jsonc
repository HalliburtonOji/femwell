{
  "name": "PersonalTasks",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "time": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "work",
        "personal",
        "wellness",
        "social"
      ],
      "default": "personal"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "date",
    "title"
  ],
  "indexes": [ { "fields": ["created_date"] }, { "fields": ["date"] } ]
}
