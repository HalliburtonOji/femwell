{
  "name": "PlannerItems",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "health",
        "personal",
        "work",
        "social",
        "wellbeing",
        "reminder"
      ],
      "default": "reminder"
    },
    "date": {
      "type": "string"
    },
    "time": {
      "type": "string"
    },
    "repeat": {
      "type": "string",
      "enum": [
        "once",
        "daily",
        "weekly",
        "monthly"
      ],
      "default": "once"
    },
    "source": {
      "type": "string",
      "description": "Which surface created this row (e.g. 'books', 'lifestyle', 'programs'). Optional; existing rows have none."
    },
    "ref": {
      "type": "string",
      "description": "Back-reference to the exact item this row is for, as 'kind:id' (e.g. 'gutenberg:1342', 'chapter:s9', 'club:littlewomen-2026q3'). Lets the planner deep-link back to the content. Optional."
    },
    "notes": {
      "type": "string"
    },
    "is_completed": {
      "type": "boolean",
      "default": false
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "title"
  ],
  "indexes": [ { "fields": ["created_date"] } ]
}
