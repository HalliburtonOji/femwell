{
  "name": "InsightCards",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "PHASE_INSIGHT",
        "SKIN_TIP",
        "NUTRITION_TIP",
        "SLEEP_TIP",
        "MOOD_TIP",
        "CYCLE_INSIGHT",
        "HABIT_TIP",
        "WEEKLY_SUMMARY",
        "CORRELATION"
      ]
    },
    "content": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "insight_date": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "insight_text": {
      "type": "string"
    },
    "recommended_action_route": {
      "type": "string"
    },
    "cycle_phase": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "confidence": {
      "type": "number"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "insight_text",
    "title"
  ],
  "indexes": [ { "fields": ["created_date"] }, { "fields": ["insight_date"] } ]
}
