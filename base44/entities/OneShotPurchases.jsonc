{
  "name": "OneShotPurchases",
  "type": "object",
  "description": "One-shot product purchases on the Horoscope Paid Shelf — Year Ahead PDF (£19), Birth Chart Atelier (£29), Choose The Day (£55). Status flows pending_payment → paid → delivered, OR simulated when Stripe price IDs aren't yet configured in env. See H2d-2.md.",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "FK to User."
    },
    "product": {
      "type": "string",
      "enum": [
        "year_ahead",
        "chart_atelier",
        "choose_the_day"
      ],
      "description": "Which product the user purchased."
    },
    "price_pence": {
      "type": "integer",
      "description": "Price in pence: 1900 (£19) / 2900 (£29) / 5500 (£55)."
    },
    "stripe_session_id": {
      "type": "string",
      "description": "Stripe checkout.session.id for the one-shot payment."
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "description": "Stripe payment_intent.id, filled by the webhook on completion."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_payment",
        "paid",
        "delivered",
        "refunded",
        "simulated"
      ],
      "default": "pending_payment",
      "description": "simulated = env Stripe price ID missing; row exists as interest-log."
    },
    "delivered_payload_url": {
      "type": "string",
      "description": "URL for the delivered PDF or unlock link."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "product"
  ]
}
