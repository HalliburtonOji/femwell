{
  // Podcast listen progress — per user per episode (lifestyle_item_id). PodcastPlayerProvider
  // upserts position/completion so playback can resume. Was referenced by code but had no
  // committed schema (resume silently failed). Personal data — default owner-based RLS.
  "name": "PodcastListens",
  "type": "object",
  "properties": {
    "user_id": { "type": "string", "description": "Listener." },
    "lifestyle_item_id": { "type": "string", "description": "The podcast episode (LifestyleItems id)." },
    "position_sec": { "type": "number", "default": 0, "description": "Last playback position in seconds." },
    "duration_sec": { "type": "number", "description": "Episode duration in seconds." },
    "completed": { "type": "boolean", "default": false, "description": "Whether the episode was finished." },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "required": [ "user_id", "lifestyle_item_id" ],
  "indexes": [ { "fields": ["user_id"] }, { "fields": ["lifestyle_item_id"] } ]
}
