{
  "name": "StoryPack",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "day_key": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "READY",
        "FAILED"
      ],
      "default": "PENDING"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "day_key"
  ],
  "indexes": [ { "fields": ["created_at"] } ]
}
